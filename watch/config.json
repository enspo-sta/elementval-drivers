{
  "comment": "Sources scanned by watch/watch_sources.py. 'start' URLs may be HTML pages or XML sitemaps (sitemap indexes are followed into their child sitemaps; HTML start pages are followed one level into same-site product-looking links). 'patterns' maps a pattern name to {brand, regex}; if the regex has a named group 'model', only that part is the model number. A source lists the pattern names it applies. Add a model number to 'ignore' to stop it being reported. 'delay_s' (optional, default 1) is the pause between pages for that source; HiFiCompass asks for 10 s in https://hificompass.com/robots.txt.",
  "sources": [
    {
      "name": "Purifi",
      "home": "https://purifi-audio.com/",
      "start": [
        "https://purifi-audio.com/",
        "https://purifi-audio.com/sitemap.xml"
      ],
      "patterns": [
        "Purifi"
      ]
    },
    {
      "name": "SB Acoustics",
      "home": "https://sbacoustics.com/",
      "start": [
        "https://sbacoustics.com/",
        "https://sbacoustics.com/sitemap.xml",
        "https://sbacoustics.com/sitemap_index.xml"
      ],
      "patterns": [
        "SB Acoustics",
        "SB Acoustics Satori"
      ]
    },
    {
      "name": "BlieSMa",
      "home": "https://www.bliesma.de/",
      "start": [
        "https://www.bliesma.de/"
      ],
      "patterns": [
        "BlieSMa (manufacturer site)"
      ]
    },
    {
      "name": "HiFiCompass",
      "home": "https://hificompass.com/",
      "start": [
        "https://hificompass.com/",
        "https://hificompass.com/sitemap.xml",
        "https://hificompass.com/en/speakers/measurements"
      ],
      "patterns": [
        "Purifi",
        "SB Acoustics",
        "SB Acoustics Satori",
        "BlieSMa (named)"
      ],
      "delay_s": 10
    },
    {
      "name": "Erin's Audio Corner",
      "home": "https://www.erinsaudiocorner.com/",
      "start": [
        "https://www.erinsaudiocorner.com/",
        "https://www.erinsaudiocorner.com/sitemap.xml",
        "https://www.erinsaudiocorner.com/driveunits/"
      ],
      "patterns": [
        "Purifi",
        "SB Acoustics",
        "SB Acoustics Satori",
        "BlieSMa (named)"
      ]
    }
  ],
  "ignore": [],
  "patterns": {
    "Purifi": {
      "brand": "Purifi",
      "regex": "(?<![A-Za-z0-9])PTT\\s?\\d{1,2}(?:[.\\-]\\d{1,2})?\\s?[A-Z]-?\\d{2}[\\s\\-]?[A-Z]{3}[\\s\\-]?\\d{2}[A-Z]?(?![A-Za-z0-9])"
    },
    "SB Acoustics": {
      "brand": "SB Acoustics",
      "regex": "(?<![A-Za-z0-9])SB\\d{2}[A-Z]{2,8}\\d{0,3}(?:-[A-Z]\\d{3})?-\\d{1,2}(?![A-Za-z0-9])"
    },
    "SB Acoustics Satori": {
      "brand": "SB Acoustics Satori",
      "regex": "(?<![A-Za-z0-9])(?:WO|MW|MR|TW|WB)\\d{2}[A-Z]{0,6}(?:-[A-Z]\\d{3})?-\\d{1,2}(?![A-Za-z0-9])"
    },
    "BlieSMa (manufacturer site)": {
      "brand": "BlieSMa",
      "regex": "(?<![A-Za-z0-9])[MT]\\d{2,3}[A-Z]{1,3}-\\d{1,2}(?![A-Za-z0-9])"
    },
    "BlieSMa (named)": {
      "brand": "BlieSMa",
      "regex": "(?i:bliesma)[\\s_\\-/]{1,3}(?P<model>[MT]\\d{2,3}[A-Z]{1,3}-\\d{1,2})(?![A-Za-z0-9])"
    }
  }
}
