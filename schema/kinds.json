{
  "comment": "Measurement kinds. Every measurement set in drivers.json names one of these in its 'kind' field; the viewer, the exporters and the checks all read this file, so a new kind of curve is added here once. 'view': how it is drawn (curve, bars or table). 'x' and 'y': axis label, unit and scale. 'ratio': the y values are dB relative to the fundamental (can be shown in percent). 'level': the set is taken at a sound pressure level that must be stated in conditions.spl_db (or ref_spl_db); sets of the same kind at different levels are matched by level. 'match': conditions that must be equal before two sets share a chart (besides the source and the level). 'export': the file formats offered for it.",
  "kinds": [
    {"id": "frequency-response", "label": "Frequency response (sound pressure on axis)", "view": "curve",
     "x": {"label": "Frequency", "unit": "Hz", "scale": "log"}, "y": {"label": "Sound pressure", "unit": "dB SPL"},
     "level": "drive", "match": ["distance_mm", "angle_deg"], "export": ["csv", "frd", "rew", "json"]},
    {"id": "impedance", "label": "Impedance", "view": "curve",
     "x": {"label": "Frequency", "unit": "Hz", "scale": "log"}, "y": {"label": "Impedance", "unit": "ohm"},
     "level": "drive", "match": [], "export": ["csv", "zma", "json"]},
    {"id": "hd-frequency", "label": "Harmonic distortion vs frequency", "view": "curve",
     "x": {"label": "Frequency", "unit": "Hz", "scale": "log"}, "y": {"label": "Harmonic", "unit": "dB re fundamental"},
     "ratio": true, "level": "spl", "match": [], "export": ["csv", "rew", "json"]},
    {"id": "hd-level", "label": "Harmonic distortion vs level (level sweep)", "view": "curve",
     "x": {"label": "Fundamental level", "unit": "dB SPL at 1 m", "scale": "linear"}, "y": {"label": "Harmonic", "unit": "dB re fundamental"},
     "ratio": true, "match": [], "export": ["csv", "json"]},
    {"id": "hd-current", "label": "Current distortion vs frequency (electrical)", "view": "curve",
     "x": {"label": "Frequency", "unit": "Hz", "scale": "log"}, "y": {"label": "Current harmonic", "unit": "dB"},
     "ratio": true, "match": [], "export": ["csv", "rew", "json"]},
    {"id": "imd-spectrum", "label": "Intermodulation, two tones (products)", "view": "bars",
     "x": {"label": "Product frequency", "unit": "Hz", "scale": "linear"}, "y": {"label": "Level", "unit": "dB"},
     "level": "spl", "match": ["tones"], "export": ["csv", "json"]},
    {"id": "imd-summary", "label": "Intermodulation, two tones (summary values)", "view": "table",
     "level": "spl-near", "match": ["tones", "ratio"], "export": ["csv", "json"]},
    {"id": "thd-bands", "label": "THD in frequency bands", "view": "table",
     "level": "spl", "match": ["type"], "export": ["csv", "json"]},
    {"id": "compression", "label": "Large-signal compression vs frequency", "view": "curve",
     "x": {"label": "Frequency", "unit": "Hz", "scale": "log"}, "y": {"label": "Compression", "unit": "dB"},
     "match": [], "export": ["csv", "rew", "json"]},
    {"id": "multitone-distortion", "label": "Large-signal distortion vs frequency (multitone)", "view": "curve",
     "x": {"label": "Frequency", "unit": "Hz", "scale": "log"}, "y": {"label": "Distortion", "unit": "dB rel"},
     "match": [], "export": ["csv", "rew", "json"]},
    {"id": "max-spl", "label": "Maximum level (calculated)", "view": "curve",
     "x": {"label": "Frequency", "unit": "Hz", "scale": "log"}, "y": {"label": "Maximum level", "unit": "dB SPL at 1 m"},
     "match": ["type"], "export": ["csv", "frd", "json"]}
  ]
}
